# Names only. Leave values empty in git. Copy to .env for local overrides.
# .env is ignored. Do not put a real token on any of these lines.

# --- Client (Vite). Baked into the bundle at build time. ---
# Optional GISTDA tile key. Empty string: those tile URLs get no key.
# The key is a rate-limit credential. It is not a secret once it is in a tile URL.
#
# THIS IS A BUILD INPUT AND IT MUST MATCH THE CI BUILD. The value in your
# local .env and the VITE_GISTDA_API_KEY repository secret must be the same
# string, or the two builds of one commit are two different products: with
# no key the GISTDA incident layer is compiled out and the map's "Incidents"
# control is not offered at all. scripts/verify-assets.mjs compares the
# deployed bytes with the local build and will report the difference.
VITE_GISTDA_API_KEY=

# Set to the string true only when building a GitHub Pages project site.
# Any other value, including empty, keeps the base path at /.
GITHUB_PAGES=

# --- Express server (server/config.ts). The public Pages site does not read these. ---
# demo (default) or live. live refuses to boot unless the two secrets below are set.
DATA_MODE=
PORT=
DATABASE_URL=
REDIS_URL=
CORS_ORIGINS=
SMARTBUS_BEARER_TOKEN=
PKSB_INGEST_API_KEY=
OPEN_METEO_BASE_URL=
NODE_ENV=

# --- Cloudflare Pages secrets and URL overrides (functions/api). ---
# Same bearer name as the Express server. Optional: adds line and destination text.
# URL overrides replace the keyless tracker and the token feed.
SMARTBUS_KEYLESS_URL=
SMARTBUS_FEED_URL=
# POST /api/collect/gps stays closed until this secret is set.
INGEST_TOKEN=

# --- Local Playwright ports. Defaults: web 4173, API 3099. ---
PLAYWRIGHT_PORT=
API_PORT=
