{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "depa-usdot-toolkit-router",
  "main": "cloudflare/toolkit-domain-router.ts",
  "compatibility_date": "2026-07-21",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "depa-usdot.nonarkara.org",
      "custom_domain": true
    }
  ],
  // Host router: rewrite the URL, drop the preview robots header, stream
  // the body. 50 ms is above that work. Logs stay on so an exceededCpu
  // on this cap is visible.
  "limits": {
    "cpu_ms": 50
  },
  "observability": {
    "enabled": true
  }
}
