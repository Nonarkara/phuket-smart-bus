{
  "name": "non-slop",
  "version": "1.0.0",
  "description": "Plug-and-play anti-slop design rules, skills and a zero-dependency scanner for AI coding agents. Removes defaults nobody chose; protects choices somebody made.",
  "type": "module",
  "bin": { "non-slop": "bin/non-slop.mjs" },
  "files": ["AGENTS.md", "CREDITS.md", "LICENSE", "README.md", "bin", "lib", "skills", "templates", "install.sh"],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "catalog": "node bin/non-slop.mjs rules --md > skills/detect/CATALOG.md"
  },
  "engines": { "node": ">=18" },
  "license": "MIT",
  "author": "Non Arkaraprasertkul",
  "repository": { "type": "git", "url": "git+https://github.com/Nonarkara/Non-Slop.git" },
  "keywords": ["ai-slop", "design", "agents", "lint", "accessibility", "claude", "cursor", "codex"]
}
